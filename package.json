{
  "name": "bb-utils",
  "version": "1.0.0",
  "description": "A collection of utility functions for browser and Node environments.",
  "keywords": [
    "esm",
    "tree-shakeable",
    "typescript",
    "utilities",
    "utils"
  ],
  "license": "MIT",
  "author": "Brendan Brown <brendanbrown27@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check --fix",
    "test": "vp test",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typedoc": "^0.28.1",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
