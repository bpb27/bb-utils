{
  "name": "bb-utils",
  "version": "0.0.0",
  "description": "A tree-shakeable collection of utility functions for browser and Node environments.",
  "type": "module",
  "license": "MIT",
  "author": "Brendan Brown <brendanbrown27@gmail.com>",
  "keywords": [
    "utils",
    "utilities",
    "tree-shakeable",
    "esm",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typedoc": "^0.28.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
