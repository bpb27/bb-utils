{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "readme": "README.md",
  "name": "bb-utils",
  "excludeInternal": true,
  "excludePrivate": true,
  "intentionallyNotExported": ["ValueType", "AnyEnum", "FieldOptions", "ArrayOptions", "FileInput"],
  "categorizeByGroup": true,
  "navigationLinks": {
    "GitHub": "https://github.com/brendanbrown/bb-utils"
  },
  "externalSymbolLinkMappings": {
    "typescript": {
      "ObjectConstructor.keys": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object/keys",
      "ObjectConstructor.values": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object/values",
      "ObjectConstructor.entries": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object/entries",
      "ObjectConstructor.fromEntries": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object/fromEntries"
    }
  }
}
